# Local temporary backup directory on the VPS
BACKUP_ROOT=/var/backups/babaei

# Encrypt the complete archive before storing it.
# Use a long random value and keep it OUTSIDE the repository.
BACKUP_ENCRYPTION_KEY=

# Optional S3-compatible off-server storage.
# Keep these secrets outside Git.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=babaei
