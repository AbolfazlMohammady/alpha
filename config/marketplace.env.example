# Marketplace carrier and payout adapter configuration
# Copy only the variables needed into config/.env (the file loaded by Django and Celery).
# Never commit config/.env or paste real tokens into issues/chat.
# A token by itself is not enough: use endpoint and response mappings from the provider's official API contract.
# Leave an integration disabled until its base URL, paths, currency and response fields have been verified.

# --- Tipax ---
TIPAX_API_BASE_URL=
TIPAX_API_TOKEN=
TIPAX_QUOTE_PATH=
TIPAX_SHIPMENT_PATH=
TIPAX_TRACKING_PATH=
TIPAX_QUOTE_AMOUNT_PATH=
TIPAX_QUOTE_CURRENCY_PATH=
TIPAX_AMOUNT_DIVISOR=
# Optional mappings when supported by the provider:
TIPAX_QUOTE_REFERENCE_PATH=
TIPAX_QUOTE_EXPIRES_PATH=
TIPAX_SHIPMENT_TRACKING_PATH=
TIPAX_SHIPMENT_ID_PATH=
TIPAX_SHIPMENT_LABEL_PATH=
TIPAX_SHIPMENT_COST_PATH=
TIPAX_SHIPMENT_CURRENCY_PATH=
TIPAX_TRACKING_STATUS_PATH=
TIPAX_TRACKING_COST_PATH=
TIPAX_TRACKING_CURRENCY_PATH=

# --- National Post ---
POST_API_BASE_URL=
POST_API_TOKEN=
POST_QUOTE_PATH=
POST_SHIPMENT_PATH=
POST_TRACKING_PATH=
POST_QUOTE_AMOUNT_PATH=
POST_QUOTE_CURRENCY_PATH=
POST_AMOUNT_DIVISOR=
POST_QUOTE_REFERENCE_PATH=
POST_QUOTE_EXPIRES_PATH=
POST_SHIPMENT_TRACKING_PATH=
POST_SHIPMENT_ID_PATH=
POST_SHIPMENT_LABEL_PATH=
POST_SHIPMENT_COST_PATH=
POST_SHIPMENT_CURRENCY_PATH=
POST_TRACKING_STATUS_PATH=
POST_TRACKING_COST_PATH=
POST_TRACKING_CURRENCY_PATH=

# --- Optional bank/PSP payout adapter; do not enable without a confirmed API contract ---
PAYOUT_API_BASE_URL=
PAYOUT_API_TOKEN=
PAYOUT_API_PATH=
PAYOUT_AMOUNT_MULTIPLIER=
PAYOUT_API_CURRENCY=
PAYOUT_RESPONSE_REFERENCE_PATH=
PAYOUT_RESPONSE_STATUS_PATH=
PAYOUT_RESPONSE_AMOUNT_PATH=
PAYOUT_RESPONSE_CURRENCY_PATH=
